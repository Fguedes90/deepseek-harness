/**
 * Measured, locked coverage debt.
 *
 * One entry per debt FILE, with its measured real coverage (lines/statements/
 * branches/functions percentages) as the LOCKED ceiling. The main coverage gate
 * keeps these files excluded from the global perFile:100 (a glob threshold does
 * NOT exempt a file from the global threshold), so they cannot sit in the 100%
 * gate at their current sub-100 values. Instead they are measured and locked by
 * the coverage-debt lane (see verify-coverage-debt.ts):
 *
 *   - real coverage BELOW the locked value  -> the debt lane's per-file glob
 *     threshold fails (vitest), naming the file.
 *   - real coverage ABOVE the locked value  -> verify-coverage-debt.ts fails,
 *     demanding the locked value be raised by reviewed edit (ratchet).
 *   - real coverage == 100                  -> verify-coverage-debt.ts fails,
 *     demanding the entry be DELETED (file returns to the global 100% regime).
 *
 * Raise a value only by raising it in the measured run and committing the new
 * number; never autoUpdate. This table is the single source of truth consumed by
 * both vitest.config.ts (debt lane + main exclude) and verify-coverage-debt.ts,
 * so the main gate and the ratchet cannot drift.
 */

/** One debt file: its glob and the locked real-coverage ceiling for each metric. */
export interface CoverageDebtEntry {
  /** Coverage-relative glob selecting exactly one source file. */
  readonly glob: string
  readonly lines: number
  readonly statements: number
  readonly branches: number
  readonly functions: number
}

/**
 * Sorted by glob. Values are the MEASURED real coverage of each file at the
 * commit that locked them. Update by re-running the debt lane and committing the
 * new numbers (ratchet: only upward, or delete at 100).
 */
